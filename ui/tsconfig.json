{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"], "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "isolatedModules": true, "noEmit": true, "skipLibCheck": true,
    "allowImportingTsExtensions": true, "types": ["vite/client", "@testing-library/jest-dom"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "tests", "vite.config.ts", "../src/contract", "../src/hub/types.ts"]
}
