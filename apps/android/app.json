{
  "expo": {
    "name": "NOONCHI",
    "slug": "noonchi-android",
    "version": "1.0.0",
    "platforms": ["android"],
    "orientation": "default",
    "scheme": "noonchi",
    "icon": "./assets/icon.png",
    "backgroundColor": "#A50034",
    "updates": { "enabled": false },
    "android": {
      "package": "app.noonchi.android",
      "versionCode": 1,
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    },
    "plugins": [
      ["expo-camera", { "recordAudioAndroid": false, "barcodeScannerEnabled": true }],
      ["expo-splash-screen", { "backgroundColor": "#A50034", "image": "./assets/splash-icon.png", "imageWidth": 72 }],
      ["expo-font", { "android": { "fonts": [
        { "fontFamily": "Pretendard-SemiBold", "fontDefinitions": [{ "path": "./assets/fonts/Pretendard-SemiBold.otf", "weight": 600 }] },
        { "fontFamily": "Pretendard-Bold", "fontDefinitions": [{ "path": "./assets/fonts/Pretendard-Bold.otf", "weight": 700 }] }
      ] } }],
      "./plugins/pretendard.cjs"
    ]
  }
}
