# 복사해서 .env로 쓴다. .env는 git에 올리지 않는다(키를 여기 말고 .env에만 넣는다).

# ── 에이전트(LLM) ──
# openai | anthropic. 비워 두면 ANTHROPIC_API_KEY가 있으면 anthropic, 없으면 openai.
# 키가 없어도 다른 공급자로 바꾸지 않는다: 에이전트가 준비 안 됨(/api/health ready.agent)이고 폰 대화가 실패한다
AGENT_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
# OpenAI 호환 서버를 쓸 때만(키 없는 확인: 가짜 서버 scripts/fake-openai.ts 주소 + OPENAI_API_KEY=fake-key)
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max (기본 low)
ANTHROPIC_EFFORT=
# off면 서버 측 거절 대체(fallbacks)를 끈다
ANTHROPIC_FALLBACKS=

# ── 관찰 흐름·폰 ──
# 1이면 폰 엔진 프레임마다 YOLO와 VLM이 분석하고 World State가 합쳐 PAM 판단을 부른다. PHONE_PORT가 있어야 한다(compose는 PHONE_PORT를 정한다)
BRAIN=1
# 폰 AR 서버 포트. 비우면 폰 서버를 띄우지 않는다. compose 안에서는 compose가 8210으로 둔다
PHONE_PORT=
# 대시보드에 맨 앞으로 보일 폰 주소. 예: https://<서버>.<tailnet>.ts.net:8443/phone/
PHONE_URL=
# 0이면 폰 주소에 이 기계의 네트워크 주소(와이파이)를 넣지 않는다(기본 1). compose는 0으로 둔다: 컨테이너 안 주소는 밖에서 열 수 없어 폰 주소는 PHONE_URL뿐이다
# PHONE_LAN_URLS=1
# 0이면 폰 위치 맞추기(시작 위치·물건 기준점·벽 모양)를 끄고 기준점 두 곳으로만 맞춘다(기본 1)
# PHONE_SYNC=1

# ── 추론(VLM·PAM) ──
# mock(기본, GPU 없음: VLM은 OpenAI) | live(GPU 서버: 같은 서버 vLLM). 두 모드는 같은 코드 경로이고 주소·모델 이름만 다르다
INFERENCE_MODE=mock
# 따로 주면 모드의 기본값 대신 쓴다(OpenAI 호환 주소). 비우면 mock은 https://api.openai.com/v1, live는 http://vllm-vlm:8000/v1
VLM_BASE_URL=
# 비우면 mock은 gpt-5.4-mini, live는 vlm(vLLM --served-model-name)
VLM_MODEL=
# 비우면 mock은 OPENAI_API_KEY, live는 VLLM_API_KEY
VLM_API_KEY=
# VLM 요청에 더할 칸(JSON 객체). 비우면 mock은 {"reasoning_effort":"none"}, live는 {}
VLM_EXTRA_BODY=
# 사진 한 장 분석 제한 시간(ms, 기본 20000)
VLM_TIMEOUT_MS=
# 엔진 프레임 간격(ms, 기본 2000, 200 이상). 엔진 프레임마다 VLM을 한 번 부른다(2초면 시간당 약 1,800번)
ENGINE_FRAME_MS=
# VLM 한 번에 보내는 최근 엔진 프레임 수(기본 5, 1~10). 오래된 것부터, 장마다 촬영 시각(t-8s … t-0s)을 붙인다. 2초 간격 5장이면 10초
VLM_WINDOW_FRAMES=
# VLM 동시 요청 상한(기본 4). 넘친 프레임은 VLM 분석 없음으로 남긴다
VLM_MAX_INFLIGHT=
# YOLO 대기열 상한(기본 8). 넘친 프레임은 YOLO·VLM 분석 없음으로 남긴다
DETECT_QUEUE_MAX=
# PAM 서비스 주소. 비우면 http://127.0.0.1:8300. compose 안에서는 compose가 http://pam:8300으로 둔다
PAM_URL=
# PAM 판단 한 번 제한 시간(ms, 기본 30000)
PAM_TIMEOUT_MS=
# PAM 판단 호출 시점: periodic(기본, 폰 엔진 프레임이 오는 동안 주기마다 그때 World State로) | event(World State에 의미 있는 변화가 있을 때)
PAM_TRIGGER=
# periodic 주기(ms, 기본 5000), event 최소 간격(ms, 기본 3000)
PAM_PERIOD_MS=
PAM_MIN_GAP_MS=
# periodic: 마지막 엔진 프레임 뒤 이만큼 지나면 부르지 않는다(ms, 기본 10000). 폰이 없으면 판단 호출·비용이 없다
PAM_LIVE_MS=
# periodic: 사람 없음 + 등장·사라짐 없음이 이만큼 이어지면 멈춘다(ms, 기본 1800000)
PAM_IDLE_STOP_MS=
# 동시에 나가 있는 판단 상한(기본 1). 앞 판단이 끝나야 다음을 부른다
PAM_MAX_INFLIGHT=
# 실행 전 검사: 대상을 마지막으로 본 뒤 이만큼 지나면 낡은 근거로 보고 실행하지 않는다(ms, 기본 3000)
STALE_MS=
# mock PAM LLM 제공자. openai면 OpenRouter 대신 OpenAI(gpt-5.4-mini, OPENAI_API_KEY)를 부른다. 비우면 OpenRouter
PAM_LLM_PROVIDER=
# PAM 서비스가 부르는 PAM LLM(OpenAI 호환 주소). 비우면 mock은 https://openrouter.ai/api/v1, live는 http://vllm-pam:8000/v1
PAM_LLM_BASE_URL=
# 비우면 mock은 qwen/qwen3.5-27b(provider alibaba), live는 pam(vLLM --served-model-name)
PAM_LLM_MODEL=
# 비우면 mock은 OPENROUTER_API_KEY, live는 VLLM_API_KEY
PAM_LLM_API_KEY=
# mock PAM LLM 키(OpenRouter)
OPENROUTER_API_KEY=
# PAM LLM 한 번 제한 시간(초, 기본 120)
PAM_LLM_TIMEOUT_S=

# ── 데이터·서버 ──
# 트윈 결과물 폴더. 비우면 저장소 twin/
TWIN_STUDIO_DIR=
# 불러올 집(twin-studio homes.json의 id). 비우면 homes.json default
# HOME_ID=oneroom
# 배치 수정본(homes/<id>/edits.json)·사진(photos/)·기록 DB(noonchi.db) 폴더의 바탕. 기본 runtime
# RUNTIME_DIR=runtime
# 기록 날짜를 나누는 시간대(분, 기본 540 = 서울)
HISTORY_TZ_MINUTES=
# 매일 반성하는 시각(HH:MM, 기록 시간대, 기본 23:30). off면 끈다
REFLECT_AT=
# 폰 사진 찍기 사진 보관 일(기본 7). 지나면 지운다
PHOTO_RETENTION_DAYS=
# 1이면 엔진 프레임을 시험 자료로 RUNTIME_DIR/dataset에 저장한다(기본 끔). 분석한 사진은 이것을 켜야만 디스크에 남는다
DATASET_COLLECT=
# 시험 자료 보관 일(기본 7). 지나면 지운다
DATASET_RETENTION_DAYS=
PORT=8200
# 기본 127.0.0.1(이 PC에서만). 0.0.0.0으로 열면 같은 LAN에서 웹 화면·API에 접근할 수 있다(인증 없음, 주의)
HOST=127.0.0.1
# 대시보드를 여는 tailscale serve 주소(쉼표로 여러 개). 예: https://<서버>.<tailnet>.ts.net
ALLOWED_ORIGINS=
# 다른 주소에서 계획(POST /api/plan)을 받을 토큰. 보내는 쪽은 Authorization: Bearer <토큰>을 붙인다. compose로 띄우면 같은 PC에서 보낸 계획도 토큰이 있어야 한다
PLAN_TOKEN=

# ── 허브 ──
# matter(기본) | memory(Matter 없이, 테스트용)
HUB=matter
# network(기본): 브리지를 UDP로 띄우고 matter.js 컨트롤러가 실제로 커미셔닝 / local: 같은 프로세스에서 behavior API로 직접
MATTER_TRANSPORT=network
# network 커미셔닝·연결 제한 시간(ms). 넘기면 local 전송으로 대신 뜬다
MATTER_COMMISSION_TIMEOUT_MS=30000
# 브리지·컨트롤러 저장소(커미셔닝 정보). 지우면 다음 시작 때 새로 커미셔닝한다
MATTER_STORAGE_DIR=.matter
# 브리지 UDP 포트(컨트롤러는 +1). 같은 LAN 컨트롤러가 붙으려면 방화벽에서 이 포트와 mDNS(5353)를 열어야 한다
MATTER_PORT=5540
# 페어링 passcode·discriminator(기본 20261011 / 3011). 공개된 기본값이므로 LAN에 열 때는 바꾼다
# MATTER_PASSCODE=
# MATTER_DISCRIMINATOR=
# address(기본, 127.0.0.1:포트로 바로) | mdns(검색)
# MATTER_DISCOVERY=
# debug | info | notice | warn | error(기본) | fatal
# MATTER_LOG_LEVEL=
# sqlite(기본) | file
# MATTER_STORAGE_DRIVER=

# ── 운영 모드(실제 모드에서만 쓴다, docs/reference.md "운영 모드") ──
# LG ThinQ Connect 개인 토큰(PAT, https://connect-pat.lgthinq.com). 여기 말고 .env에만 넣는다
THINQ_TOKEN=
# 나라 코드(기본 KR), 지역 kic | aic | eic(기본 kic)
# THINQ_COUNTRY=KR
# THINQ_REGION=kic
# 짝지은 가전 읽기 간격(ms, 기본 15000), 명령 뒤 다시 읽기 전 기다림(ms, 기본 1000,2000,4000)
# THINQ_POLL_MS=15000
# THINQ_READBACK_MS=1000,2000,4000

# ── MCP ──
# MCP 서버(npm run mcp)가 부를 twin-home 서버 주소
TWIN_HOME_URL=http://127.0.0.1:8200

# ── 배포(compose.yaml, docs/deploy.md) ──
# 호스트에 여는 포트(127.0.0.1에만). 비우면 8200·8210
NOONCHI_PORT=
NOONCHI_PHONE_PORT=
# 호스트에 여는 PAM 서비스 포트(127.0.0.1에만). 비우면 8300
PAM_HOST_PORT=
# vLLM 이미지(비우면 vllm/vllm-openai:v0.17.0)
VLLM_IMAGE=
# live VLM Hugging Face 모델(비우면 Qwen/Qwen3-VL-4B-Instruct). vLLM은 vlm이라는 이름으로 내건다
VLM_LIVE_MODEL=
# live PAM LLM Hugging Face 모델(비우면 Qwen/Qwen3.5-27B-GPTQ-Int4). vLLM은 pam이라는 이름으로 내건다
PAM_LIVE_MODEL=
# PAM LLM 문맥 길이(비우면 32768). vLLM --max-model-len과 PAM 서비스 입력 한도가 같이 쓴다
PAM_MAX_MODEL_LEN=
# 한 GPU에서 나눠 잡는 메모리 몫(비우면 0.30·0.60). 합이 0.9를 넘지 않게
VLLM_VLM_GPU_SHARE=
VLLM_PAM_GPU_SHARE=
# vLLM 서버 키(쓰면 noonchi live VLM도 이 키로 부른다)
VLLM_API_KEY=
# Hugging Face 토큰(받기 제한이 있는 모델만)
HF_TOKEN=
